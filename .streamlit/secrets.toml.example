# Copy to .streamlit/secrets.toml (git-ignored) for LOCAL development:
#   Windows:  copy .streamlit\secrets.toml.example .streamlit\secrets.toml
#
# On Streamlit Community Cloud do NOT commit a secrets file: paste these lines into
# App settings -> Secrets instead, using your Vercel API URL.

API_URL = "http://127.0.0.1:8000"   # local backend. In production: "https://<your-project>.vercel.app"

# Only needed if you set API_KEY on the backend:
# API_KEY = "the-same-value-as-on-the-backend"

# Optional: seconds to wait for the backend (default 60; a sleeping free-tier backend needs ~60 s)
# REQUEST_TIMEOUT = "60"
